<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\MyCollection.Infrastructure\MyCollection.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- 顯式釘住 2.x 線的下限，避開 GHSA-v5pm-xwqc-g5wc（影響 [2.0.0-preview.11, 2.7.4] 與 [3.0.0, 3.5.3]）。
         版本須 ≥ AspNetCore.OpenApi 要求的下限（10.0.12 起為 2.12.0），否則會觸發 NU1605，
         在 TreatWarningsAsErrors 下直接使還原失敗；升級 AspNetCore.OpenApi 時要一併檢查。 -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 開發環境的連線字串與金鑰改放 user secrets，不落在專案目錄內 -->
    <UserSecretsId>mycollection-api-9f2c4b1e-5d83-47a6-b0f1-2c7e8a3d6b54</UserSecretsId>
  </PropertyGroup>

</Project>
